{
  "name": "bca-platform",
  "version": "1.0.0",
  "description": "Plateforme web B.C.A. - Centre de Formation, Communication et Portail Local à Tiaret",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "install:all": "npm install && npm install --workspace=server && npm install --workspace=client",
    "seed": "npm run seed --workspace=server",
    "backup": "npm run backup --workspace=server"
  },
  "keywords": [
    "mern",
    "bca",
    "tiaret",
    "formation",
    "communication",
    "annonces"
  ],
  "author": "B.C.A. Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
