# ==============================================================================
# CONFIGURATION DU SERVEUR B.C.A. (TIARET) - BACKEND
# ==============================================================================

# Environnement de l'application (development | production | test)
NODE_ENV=development

# Port d'écoute du serveur HTTP Express
PORT=5000

# URL publique du client frontend (pour CORS et redirection des liens emails)
CLIENT_URL=http://localhost:5173

# ==============================================================================
# BASE DE DONNÉES MONGODB
# ==============================================================================
# URI de connexion MongoDB locale ou MongoDB Atlas (Cloud)
# Format local : mongodb://127.0.0.1:27017/bca_db
# Format Atlas : mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/bca_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/bca_db

# ==============================================================================
# SÉCURITÉ & AUTHENTIFICATION (JWT)
# ==============================================================================
# Clé secrète pour signer les Access Tokens (utilisez une chaîne aléatoire longue et complexe de 64+ caractères)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production_min_64_chars_long

# Durée de validité de l'access token (ex: 15m, 30m, 1h)
JWT_ACCESS_EXPIRES_IN=15m

# Clé secrète pour signer les Refresh Tokens
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production_min_64_chars_long

# Durée de validité du refresh token stocké en cookie HTTP-Only (ex: 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# Clé secrète pour signer les cookies signés
COOKIE_SECRET=your_cookie_signing_secret_here

# ==============================================================================
# CONFIGURATION EMAIL (NODEMAILER / SMTP)
# ==============================================================================
# Hôte SMTP (ex: smtp.gmail.com, mail.votredomaine.dz, sandbox Mailtrap en dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact.bca.tiaret@gmail.com
# Pour Gmail, utilisez un mot de passe d'application généré depuis le compte Google
SMTP_PASS=your_app_password_here
# Nom et adresse d'expédition des e-mails envoyés par la plateforme
SMTP_FROM_NAME="B.C.A. Centre & Portail Tiaret"
SMTP_FROM_EMAIL=no-reply@bca-tiaret.dz

# Email recevant les notifications d'inscriptions, devis et messages de contact
ADMIN_NOTIFICATION_EMAIL=direction@bca-tiaret.dz

# ==============================================================================
# UPLOADS & GESTION DES MÉDIAS (SHARP / MULTER)
# ==============================================================================
# Taille maximale autorisée par fichier uploadé (en octets : 10 Mo = 10485760)
MAX_FILE_SIZE_BYTES=10485760
# Répertoire local de stockage des fichiers uploadés
UPLOAD_PATH=uploads

# ==============================================================================
# ANTI-SPAM & SÉCURITÉ FORMULAIRES
# ==============================================================================
# Nom du champ honeypot attendu vide sur les formulaires
HONEYPOT_FIELD_NAME=website_hp
# Clé secrète Google reCAPTCHA v3 ou Turnstile Cloudflare (optionnel, vide si désactivé)
RECAPTCHA_SECRET_KEY=

# ==============================================================================
# SAUVEGARDE AUTOMATIQUE DE LA BASE DE DONNÉES (CRON)
# ==============================================================================
# Répertoire où stocker les dumps MongoDB compressés
BACKUP_DIR=backups
# Expression cron pour la sauvegarde automatique (ex: tous les soirs à 02h00 : 0 2 * * *)
BACKUP_CRON_SCHEDULE="0 2 * * *"
# Rétention des sauvegardes en jours (les backups de plus de X jours sont purgés)
BACKUP_RETENTION_DAYS=30

# ==============================================================================
# SEED INITIAL (COMPTE SUPER ADMIN PAR DÉFAUT)
# ==============================================================================
# Identifiants créés lors de l'exécution de `npm run seed`
INITIAL_ADMIN_NAME="Directeur B.C.A."
INITIAL_ADMIN_EMAIL=admin@bca-tiaret.dz
INITIAL_ADMIN_PASSWORD=AdminSecurePass2026!
INITIAL_ADMIN_PHONE=0550000000
